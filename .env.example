# Copy to .env for scripts/start_demo.py. Existing environment variables take priority.
# Default mode does not call any external model.
MODEL_PROVIDER=replay
DEMO_DATA_DIR=data

# Optional shared access code for API requests; use a long random value for remote demos.
DEMO_ACCESS_TOKEN=

# Optional FREE Zhipu text model. Use configure-zhipu.cmd to fill the key locally.
# Official pricing checked 2026-11-10; recheck if the provider changes its pricing.
# This demo rejects other endpoints/models and never falls back to a paid model.
# MODEL_PROVIDER=zhipu-free
# MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# MODEL_NAME=glm-4-flash-250414
# Also allowlisted: glm-4.7-flash. Switch manually only; no automatic fallback.
# MODEL_API_KEY=your-api-key
